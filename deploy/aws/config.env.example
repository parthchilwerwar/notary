# deploy/aws/config.env — copy this file to config.env and edit. It holds no secrets (safe to commit).
# Names, sizes and model ids only. NO secrets here: keys go to AWS Secrets Manager via put-secrets.sh.
AWS_REGION=us-east-1
NOTARY_APP=notary
NOTARY_ECR_REPO=notary
NOTARY_CLUSTER=notary
NOTARY_SERVICE=notary-api
# Secrets Manager prefix: one secret per variable, e.g. notary/prod/LITELLM_API_KEY
NOTARY_SECRET_NAME=notary/prod

# Models (LiteLLM model names, as `pnpm notary doctor --llm` lists them)
NOTARY_LLM_PROVIDER=litellm
NOTARY_MODEL_EXECUTOR=claude-haiku
NOTARY_MODEL_REFLECTOR=claude-haiku
NOTARY_MODEL_ADVERSARY=claude-sonnet-4.6
# Notary Chat; empty = falls back to NOTARY_MODEL_REFLECTOR
NOTARY_MODEL_CHAT=

# Spend and rate limits on the hosted API: USD cap per chat message / per agents run, chat messages per minute per task
NOTARY_MAX_USD=0.25
NOTARY_ASK_RPM=10

# Comma-separated https origins allowed to call the hosted API from a browser (the dashboard's URL)
NOTARY_ALLOWED_ORIGINS=

# Fargate size (CPU units / MiB) and architecture (X86_64 | ARM64), API scaling
NOTARY_CPU=1024
NOTARY_MEMORY=2048
NOTARY_CPU_ARCH=X86_64
NOTARY_MIN_TASKS=1
NOTARY_MAX_TASKS=2
NOTARY_LOG_GROUP=/ecs/notary

# Optional: shared runs/ on EFS (agents task writes, API reads). Empty = runs baked into the image.
NOTARY_EFS_ID=
NOTARY_EFS_ACCESS_POINT=
# Optional: network for the agents task (default VPC subnets otherwise)
NOTARY_SUBNETS=
NOTARY_SECURITY_GROUPS=
