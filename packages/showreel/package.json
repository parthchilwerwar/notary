{
  "name": "@notary/showreel",
  "version": "0.0.0",
  "private": true,
  "description": "The 15-second Notary showreel, rendered with Remotion from the published, hash-verified records",
  "type": "module",
  "scripts": {
    "props": "tsx --import ./scripts/node/vite-env.mjs scripts/props.ts",
    "studio": "remotion studio src/index.ts",
    "render": "tsx scripts/render.ts",
    "still": "tsx scripts/stills.ts",
    "typecheck": "tsc --noEmit",
    "audio": "tsx scripts/audio.ts",
    "verify-audio": "tsx scripts/verify-audio.ts",
    "voice": "tsx scripts/voice.ts",
    "captions": "tsx scripts/captions.ts",
    "explainer-data": "tsx scripts/explainer-data.ts",
    "explainer:prep": "tsx scripts/explainer-prep.ts",
    "explainer:audio": "tsx scripts/explainer-audio.ts",
    "explainer:render": "tsx scripts/explainer-render.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@remotion/bundler": "4.0.524",
    "@remotion/cli": "4.0.524",
    "@remotion/fonts": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "remotion": "4.0.524",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
