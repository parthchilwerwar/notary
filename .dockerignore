# Secrets never enter the build context.
.env
.env.*
!.env.example
**/*.pem
**/*.key
deploy/aws/config.env
packages/core/config/cfo-oauth.json
packages/core/config/cfo.json
packages/core/config/cfo-last-sync.json

# Dependencies and build output are rebuilt inside the image.
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo

# Local run state: only deploy/aws/data/runs (staged real bundles) goes in.
packages/core/runs
**/*.sqlite
**/*.sqlite-journal
**/*.db

# Not needed at runtime.
.git
.claude
.entire
docs
export
packages/showreel/src
packages/showreel/public
packages/web/src
packages/web/test
packages/web/docs
packages/web/scripts
packages/core/test
**/.vitest
**/.DS_Store
